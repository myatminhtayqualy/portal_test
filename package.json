{
  "name": "disaster-alert-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply disaster-alerts --local",
    "db:migrate:remote": "wrangler d1 migrations apply disaster-alerts --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.9"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.40.0"
  }
}
