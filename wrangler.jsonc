{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "disaster-alert-portal",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-13",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/files/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "disaster-alerts",
			"database_id": "d16be390-bfde-4a43-b28a-fe39aa9622cb",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "disaster-alert-images"
		}
	]
}